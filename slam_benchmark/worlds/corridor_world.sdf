<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="corridor_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>2.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane — centered on corridor midpoint (-2.5, 1.0); sized to cover full interior + walls -->
    <model name="ground_plane">
      <static>true</static>
      <pose>-2.5 1.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>24 8</size></plane></geometry>
          <surface>
            <friction>
              <ode>
                <mu>100000.0</mu>
                <mu2>100000.0</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 8</size></plane></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!--
      Racetrack corridor: 20 m long × 4 m wide (interior).
        x interior: -12.5 to  +7.5
        y interior:  -1.0 to  +3.0
      Divider layout at y=1.0 (west → east):
        wall | 2.0 m passage | 2 m piece | 2 m gap | 12 m piece | 2.0 m passage | wall
        x:  -12.5    -10.5  -8.5  -6.5              +5.5  +7.5
      Gap only on west side — asymmetric ends help SLAM/AMCL distinguish corridor orientation.
      Featureless zone (LiDAR 3.5 m range): x ∈ [-3, +2] → 5 m where robot sees only walls.
      Lane centres:
        South lane: y ≈  0.0  (wall inner face y=-1.0, divider south face y=0.9)
        North lane: y ≈  2.0  (divider north face y=1.1, wall inner face y=3.0)
      Spawn: (0.0, 0.0) — south lane centre.
      Waypoint corners: x = -11.5 (west), x = +6.5 (east).
    -->

    <!-- South wall -->
    <model name="south_wall">
      <static>true</static>
      <pose>-2.5 -1.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.4 0.2 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North wall -->
    <model name="north_wall">
      <static>true</static>
      <pose>-2.5 3.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.4 0.2 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West end wall -->
    <model name="west_wall">
      <static>true</static>
      <pose>-12.6 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4.4 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East end wall -->
    <model name="east_wall">
      <static>true</static>
      <pose>7.6 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 4.4 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 4.4 1</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Divider short piece (west side only): x ∈ [-10.5, -8.5] (2 m) -->
    <model name="divider_short">
      <static>true</static>
      <pose>-9.5 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 0.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Divider main piece: x ∈ [-6.5, +5.5] (12 m) -->
    <model name="divider_main">
      <static>true</static>
      <pose>-0.5 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry>
          <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.4 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
